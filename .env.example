# Public site URL, used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://www.suraxil.com

# Google Tag Manager container ID. Defaults to GTM-MMJWJ43T (src/config/site.ts)
# if left empty -- set this only to point a specific environment (e.g. staging)
# at a different container.
NEXT_PUBLIC_GTM_ID=

# Google Analytics measurement ID (leave empty until GA is ready to go live).
NEXT_PUBLIC_GA_ID=
